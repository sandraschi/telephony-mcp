# src/telephony_mcp/server.py

import asyncio
import logging
import os
from typing import Any

from fastmcp import FastMCP, Context

from telephony_mcp.providers.asterisk_provider import AsteriskProvider
from telephony_mcp.providers.twilio_provider import TwilioProvider

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("telephony-mcp")

mcp = FastMCP(
    "Telephony Bridge",
    instructions=(
        "MCP server for telephony operations — emergency calls and SMS via "
        "Asterisk/ARI or Twilio. Set TELEPHONY_PROVIDER=asterisk (default) or "
        "TELEPHONY_PROVIDER=twilio. Numbers must be E.164 format (+43...)."
    ),
)


def get_provider():
    """Return the active telephony provider based on TELEPHONY_PROVIDER env var."""
    mode = os.getenv("TELEPHONY_PROVIDER", "asterisk").lower()
    if mode == "twilio":
        return TwilioProvider()
    return AsteriskProvider()


@mcp.tool()
async def make_emergency_call(
    to_number: str,
    message: str,
    ctx: Context,
) -> dict[str, Any]:
    """
    Trigger an automated emergency call with a German TTS message.

    Args:
        to_number: Destination phone number in E.164 format (e.g. +43664XXXXXXX).
        message: The German-language message to be spoken to the recipient.

    Returns:
        dict with keys: success (bool), call_id (str), mode (str), error (str, on failure).
    """
    await ctx.info(f"Initiating emergency call to {to_number}")
    provider = get_provider()
    result = await provider.make_call(to_number, message, script_type="emergency")
    return result


@mcp.tool()
async def send_emergency_sms(
    to_number: str,
    text: str,
    ctx: Context,
) -> dict[str, Any]:
    """
    Send an automated emergency SMS.

    Args:
        to_number: Destination phone number in E.164 format (e.g. +43664XXXXXXX).
        text: SMS body content.

    Returns:
        dict with keys: success (bool), sms_id (str), mode (str), error (str, on failure).
    """
    await ctx.info(f"Sending emergency SMS to {to_number}")
    provider = get_provider()
    result = await provider.send_sms(to_number, text)
    return result


@mcp.tool()
async def telephony_dispatch_test(
    sip_uri: str,
    ctx: Context,
) -> dict[str, Any]:
    """
    Dry-run rescue verification call to a test SIP URI.

    Sends a fixed German test message to verify the RoboFang rescue chain is
    operational. Use a Linphone or similar softphone as the target.

    Args:
        sip_uri: Destination SIP URI (e.g. sip:linphone@localhost).

    Returns:
        dict with keys: success (bool), call_id (str), mode (str), error (str, on failure).
    """
    test_msg = (
        "Achtung. Dies ist ein Test der RoboFang Rettungskette. "
        "Bitte bestaetigen Sie den Empfang."
    )
    await ctx.info(f"Dispatch test call to {sip_uri}")
    provider = get_provider()
    result = await provider.make_call(sip_uri, test_msg, script_type="test")
    return result


@mcp.tool()
async def telephony_status(ctx: Context) -> dict[str, Any]:
    """
    Return the current telephony configuration and provider status.

    Returns:
        dict with provider name, configured env vars (redacted), and readiness.
    """
    provider_name = os.getenv("TELEPHONY_PROVIDER", "asterisk").lower()
    if provider_name == "twilio":
        ready = bool(
            os.getenv("TWILIO_ACCOUNT_SID")
            and os.getenv("TWILIO_AUTH_TOKEN")
            and os.getenv("TWILIO_FROM_NUMBER")
        )
        config = {
            "TWILIO_ACCOUNT_SID": "set" if os.getenv("TWILIO_ACCOUNT_SID") else "missing",
            "TWILIO_AUTH_TOKEN": "set" if os.getenv("TWILIO_AUTH_TOKEN") else "missing",
            "TWILIO_FROM_NUMBER": os.getenv("TWILIO_FROM_NUMBER", "missing"),
        }
    else:
        ari_url = os.getenv("ASTERISK_ARI_URL", "http://localhost:8088/ari")
        ready = True  # Asterisk connectivity is checked at call time
        config = {
            "ASTERISK_ARI_URL": ari_url,
            "ASTERISK_ARI_USER": os.getenv("ASTERISK_ARI_USER", "robofang"),
            "ASTERISK_ARI_PASS": "set" if os.getenv("ASTERISK_ARI_PASS") else "default",
        }

    return {
        "provider": provider_name,
        "ready": ready,
        "config": config,
    }


def main() -> None:
    mcp.run()


if __name__ == "__main__":
    main()
