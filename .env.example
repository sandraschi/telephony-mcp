# telephony-mcp — copy to .env and fill in (never commit .env)
# Backend port pair: 10952 (API) / 10953 (Vite frontend)

# Which provider to use: asterisk (default, ARI + speechops TTS) or twilio
TELEPHONY_PROVIDER=asterisk

# --- Asterisk ARI (default provider) ---
ASTERISK_ARI_URL=http://localhost:8088/ari
ASTERISK_ARI_USER=robofang
ASTERISK_ARI_PASS=change_me
ASTERISK_OUTBOUND_ENDPOINT=provider-endpoint
ARI_ANSWER_TIMEOUT_S=30
ARI_PLAYBACK_TIMEOUT_S=60

# --- speechops TTS (Asterisk audio source) ---
SPEECHOPS_BASE_URL=http://localhost:10918
SPEECHOPS_TTS_PROVIDER=gemini
SPEECHOPS_TTS_VOICE=Kore
SPEECHOPS_TIMEOUT_S=10

# --- Twilio (only when TELEPHONY_PROVIDER=twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Local paths / ports ---
TELEPHONY_DB_PATH=./data/calls.db
TELEPHONY_CONTACTS_PATH=./data/contacts.json
TELEPHONY_AUDIO_SHARE=./audio/tts
TELEPHONY_BACKEND_PORT=10952
WEB_PORT=10952
