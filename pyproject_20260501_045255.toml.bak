[project]
name = "telephony-mcp"
version = "0.1.0"
description = "FastMCP 3.2 Telephony Bridge — emergency calls and SMS via Asterisk/ARI or Twilio"
authors = [
    { name = "sandraschi", email = "sandraschi@users.noreply.github.com" }
]
dependencies = [
    "fastmcp>=3.2.0",
    "twilio>=8.0.0",
    "aiohttp>=3.9.0",
    "python-dotenv>=1.0.0",
    "pydantic>=2.0.0",
]
readme = "README.md"
requires-python = ">=3.10"

[project.scripts]
telephony-mcp = "telephony_mcp.server:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
