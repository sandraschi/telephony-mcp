import { useEffect, useState } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import {
  Phone, MessageSquare, Activity, RefreshCw,
  CheckCircle, XCircle, ChevronRight, Server, Mic,
  AlertTriangle, Clock, Hash
} from 'lucide-react'
import { create } from 'zustand'

// ── Types ────────────────────────────────────────────────────────────────────

interface CallRecord {
  id: number
  ts: string
  op: string
  to_number: string
  message: string
  script_type: string
  provider: string
  success: boolean
  call_id: string | null
  error: string | null
  audio_played: boolean
  duration_ms: number
}

interface Stats {
  total_calls: number
  successful: number
  failed: number
  last_call: { ts: string; to_number: string; success: boolean } | null
}

interface Health {
  status: string
  version: string
  asterisk: boolean
  speechops: boolean
}

interface StatusConfig {
  provider: string
  config: Record<string, string>
}

// ── Store ────────────────────────────────────────────────────────────────────

interface Store {
  calls: CallRecord[]
  stats: Stats | null
  health: Health | null
  statusConfig: StatusConfig | null
  loading: boolean
  selected: CallRecord | null
  page: 'log' | 'status'
  setPage: (p: 'log' | 'status') => void
  setSelected: (r: CallRecord | null) => void
  fetchAll: () => Promise<void>
}

const useStore = create<Store>((set, get) => ({
  calls: [],
  stats: null,
  health: null,
  statusConfig: null,
  loading: false,
  selected: null,
  page: 'log',
  setPage: (page) => set({ page }),
  setSelected: (selected) => set({ selected }),
  fetchAll: async () => {
    set({ loading: true })
    try {
      const [callsRes, statsRes, healthRes, statusRes] = await Promise.all([
        fetch('/api/calls?limit=100'),
        fetch('/api/stats'),
        fetch('/api/health'),
        fetch('/api/status'),
      ])
      const [callsData, statsData, healthData, statusData] = await Promise.all([
        callsRes.json(), statsRes.json(), healthRes.json(), statusRes.json(),
      ])
      set({
        calls: callsData.calls ?? [],
        stats: statsData,
        health: healthData,
        statusConfig: statusData,
      })
    } catch (e) {
      console.error('fetch error', e)
    } finally {
      set({ loading: false })
    }
  },
}))

// ── Helpers ──────────────────────────────────────────────────────────────────

const opIcon = (op: string) => {
  if (op === 'send_sms') return <MessageSquare size={14} className="text-blue-400" />
  return <Phone size={14} className="text-amber-400" />
}

const opLabel: Record<string, string> = {
  make_call: 'Call',
  send_sms: 'SMS',
  dispatch_test: 'Test',
}

const fmtTs = (ts: string) => {
  const d = new Date(ts)
  return d.toLocaleString('de-AT', { dateStyle: 'short', timeStyle: 'medium' })
}

const fmtDuration = (ms: number) => {
  if (ms < 1000) return `${ms}ms`
  return `${(ms / 1000).toFixed(1)}s`
}

// ── Components ───────────────────────────────────────────────────────────────

function StatCard({ label, value, accent }: { label: string; value: number | string; accent?: string }) {
  return (
    <div className="bg-zinc-900 border border-zinc-800 rounded-lg p-4 flex flex-col gap-1">
      <span className="text-xs text-zinc-500 uppercase tracking-wider">{label}</span>
      <span className={`text-2xl font-semibold ${accent ?? 'text-zinc-100'}`}>{value}</span>
    </div>
  )
}

function ProviderDot({ ok }: { ok: boolean }) {
  return (
    <span className={`inline-block w-2 h-2 rounded-full ${ok ? 'bg-emerald-400' : 'bg-red-500'}`} />
  )
}

function CallDetail({ record, onClose }: { record: CallRecord; onClose: () => void }) {
  return (
    <motion.div
      initial={{ opacity: 0, x: 40 }}
      animate={{ opacity: 1, x: 0 }}
      exit={{ opacity: 0, x: 40 }}
      className="fixed inset-y-0 right-0 w-96 bg-zinc-900 border-l border-zinc-800 p-6 overflow-y-auto z-50 shadow-2xl"
    >
      <div className="flex items-center justify-between mb-6">
        <span className="text-sm font-medium text-zinc-300">Call #{record.id}</span>
        <button onClick={onClose} className="text-zinc-500 hover:text-zinc-200 text-xl leading-none">&times;</button>
      </div>

      <dl className="space-y-3 text-sm">
        {[
          ['Timestamp', fmtTs(record.ts)],
          ['Operation', opLabel[record.op] ?? record.op],
          ['To', record.to_number],
          ['Provider', record.provider],
          ['Script type', record.script_type],
          ['Duration', fmtDuration(record.duration_ms)],
          ['Call ID', record.call_id ?? '—'],
        ].map(([k, v]) => (
          <div key={k} className="flex justify-between gap-2">
            <dt className="text-zinc-500">{k}</dt>
            <dd className="text-zinc-200 font-mono text-right truncate max-w-[60%]">{v}</dd>
          </div>
        ))}

        <div className="flex justify-between">
          <dt className="text-zinc-500">Status</dt>
          <dd>{record.success
            ? <span className="text-emerald-400 flex items-center gap-1"><CheckCircle size={13} /> Success</span>
            : <span className="text-red-400 flex items-center gap-1"><XCircle size={13} /> Failed</span>
          }</dd>
        </div>

        <div className="flex justify-between">
          <dt className="text-zinc-500">Audio played</dt>
          <dd className={record.audio_played ? 'text-emerald-400' : 'text-zinc-500'}>
            {record.audio_played ? 'Yes' : 'No'}
          </dd>
        </div>

        {record.error && (
          <div className="mt-4 p-3 bg-red-950 border border-red-800 rounded-md text-red-300 text-xs font-mono break-words">
            {record.error}
          </div>
        )}
      </dl>

      <div className="mt-6">
        <p className="text-xs text-zinc-500 mb-2">Message</p>
        <div className="bg-zinc-800 rounded-md p-3 text-zinc-300 text-sm leading-relaxed">
          {record.message}
        </div>
      </div>
    </motion.div>
  )
}

function CallLogPage() {
  const { calls, stats, loading, selected, setSelected } = useStore()

  return (
    <div className="space-y-6">
      {/* Stats row */}
      {stats && (
        <div className="grid grid-cols-3 gap-4">
          <StatCard label="Total calls" value={stats.total_calls} />
          <StatCard label="Successful" value={stats.successful} accent="text-emerald-400" />
          <StatCard label="Failed" value={stats.failed} accent={stats.failed > 0 ? 'text-red-400' : 'text-zinc-400'} />
        </div>
      )}

      {/* Table */}
      <div className="bg-zinc-900 border border-zinc-800 rounded-lg overflow-hidden">
        <div className="px-4 py-3 border-b border-zinc-800 flex items-center justify-between">
          <span className="text-sm font-medium text-zinc-300">Call Log</span>
          {loading && <RefreshCw size={14} className="text-zinc-500 animate-spin" />}
        </div>

        {calls.length === 0 && !loading ? (
          <div className="px-4 py-10 text-center text-zinc-500 text-sm">No calls logged yet.</div>
        ) : (
          <table className="w-full text-sm">
            <thead>
              <tr className="text-xs text-zinc-500 uppercase tracking-wider border-b border-zinc-800">
                <th className="px-4 py-2 text-left w-6"><Hash size={11}/></th>
                <th className="px-4 py-2 text-left"><Clock size={11}/></th>
                <th className="px-4 py-2 text-left">Op</th>
                <th className="px-4 py-2 text-left">To</th>
                <th className="px-4 py-2 text-left">Provider</th>
                <th className="px-4 py-2 text-left">Duration</th>
                <th className="px-4 py-2 text-left">Status</th>
                <th className="px-4 py-2" />
              </tr>
            </thead>
            <tbody>
              {calls.map((c) => (
                <tr
                  key={c.id}
                  onClick={() => setSelected(selected?.id === c.id ? null : c)}
                  className={`border-b border-zinc-800/50 cursor-pointer transition-colors
                    ${selected?.id === c.id ? 'bg-zinc-800' : 'hover:bg-zinc-800/50'}`}
                >
                  <td className="px-4 py-2.5 text-zinc-600 font-mono text-xs">{c.id}</td>
                  <td className="px-4 py-2.5 text-zinc-400 font-mono text-xs whitespace-nowrap">{fmtTs(c.ts)}</td>
                  <td className="px-4 py-2.5">
                    <span className="flex items-center gap-1.5">
                      {opIcon(c.op)}
                      <span className="text-zinc-300">{opLabel[c.op] ?? c.op}</span>
                    </span>
                  </td>
                  <td className="px-4 py-2.5 font-mono text-zinc-300 text-xs">{c.to_number}</td>
                  <td className="px-4 py-2.5 text-zinc-400 text-xs">{c.provider}</td>
                  <td className="px-4 py-2.5 text-zinc-400 font-mono text-xs">{fmtDuration(c.duration_ms)}</td>
                  <td className="px-4 py-2.5">
                    {c.success
                      ? <CheckCircle size={14} className="text-emerald-400" />
                      : <XCircle size={14} className="text-red-400" />
                    }
                  </td>
                  <td className="px-4 py-2.5 text-zinc-600">
                    <ChevronRight size={14} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      <AnimatePresence>
        {selected && <CallDetail record={selected} onClose={() => setSelected(null)} />}
      </AnimatePresence>
    </div>
  )
}

function StatusPage() {
  const { health, statusConfig } = useStore()

  return (
    <div className="space-y-6 max-w-lg">
      {/* Connectivity */}
      <div className="bg-zinc-900 border border-zinc-800 rounded-lg p-5 space-y-4">
        <h2 className="text-sm font-medium text-zinc-300">Connectivity</h2>
        {health ? (
          <dl className="space-y-2 text-sm">
            <div className="flex items-center justify-between">
              <dt className="flex items-center gap-2 text-zinc-400"><Server size={14}/> Asterisk ARI</dt>
              <dd className="flex items-center gap-1.5">
                <ProviderDot ok={health.asterisk} />
                <span className={health.asterisk ? 'text-emerald-400' : 'text-red-400'}>
                  {health.asterisk ? 'Online' : 'Offline'}
                </span>
              </dd>
            </div>
            <div className="flex items-center justify-between">
              <dt className="flex items-center gap-2 text-zinc-400"><Mic size={14}/> speechops TTS</dt>
              <dd className="flex items-center gap-1.5">
                <ProviderDot ok={health.speechops} />
                <span className={health.speechops ? 'text-emerald-400' : 'text-amber-400'}>
                  {health.speechops ? 'Online' : 'Offline (fallback active)'}
                </span>
              </dd>
            </div>
          </dl>
        ) : (
          <div className="text-zinc-500 text-sm">Loading…</div>
        )}
      </div>

      {/* Config */}
      {statusConfig && (
        <div className="bg-zinc-900 border border-zinc-800 rounded-lg p-5 space-y-3">
          <h2 className="text-sm font-medium text-zinc-300">
            Provider: <span className="text-amber-400">{statusConfig.provider}</span>
          </h2>
          <dl className="space-y-2 text-xs font-mono">
            {Object.entries(statusConfig.config).map(([k, v]) => (
              <div key={k} className="flex justify-between gap-4">
                <dt className="text-zinc-500">{k}</dt>
                <dd className={v === 'missing' ? 'text-red-400' : v === 'set' ? 'text-emerald-400' : 'text-zinc-300'}>
                  {v}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      {health && !health.asterisk && (
        <div className="flex items-start gap-2 text-amber-300 bg-amber-950 border border-amber-800 rounded-lg p-4 text-sm">
          <AlertTriangle size={16} className="mt-0.5 shrink-0" />
          <span>Asterisk container is offline. Run <code className="font-mono text-amber-200">docker-compose up -d</code> in the telephony-mcp directory.</span>
        </div>
      )}
    </div>
  )
}

// ── App ───────────────────────────────────────────────────────────────────────

export default function App() {
  const { page, setPage, fetchAll, loading, health } = useStore()

  useEffect(() => {
    fetchAll()
    const interval = setInterval(fetchAll, 30_000)
    return () => clearInterval(interval)
  }, [])

  const navItems = [
    { id: 'log' as const, label: 'Call Log', icon: <Activity size={16} /> },
    { id: 'status' as const, label: 'Status', icon: <Server size={16} /> },
  ]

  return (
    <div className="min-h-screen bg-zinc-950 flex">
      {/* Sidebar */}
      <aside className="w-52 shrink-0 border-r border-zinc-800 flex flex-col">
        <div className="px-5 py-5 border-b border-zinc-800">
          <div className="flex items-center gap-2">
            <Phone size={18} className="text-amber-400" />
            <span className="text-sm font-semibold text-zinc-100">Telephony MCP</span>
          </div>
          <div className="text-xs text-zinc-500 mt-1">Audit Dashboard</div>
        </div>

        <nav className="flex-1 px-3 py-4 space-y-1">
          {navItems.map((item) => (
            <button
              key={item.id}
              onClick={() => setPage(item.id)}
              className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition-colors
                ${page === item.id
                  ? 'bg-amber-500/10 text-amber-400'
                  : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800'}`}
            >
              {item.icon}
              {item.label}
            </button>
          ))}
        </nav>

        <div className="px-4 py-3 border-t border-zinc-800 flex items-center gap-2">
          <ProviderDot ok={health?.asterisk ?? false} />
          <span className="text-xs text-zinc-500">
            {health?.asterisk ? 'Asterisk online' : 'Asterisk offline'}
          </span>
        </div>
      </aside>

      {/* Main */}
      <main className="flex-1 flex flex-col min-w-0">
        {/* Topbar */}
        <header className="h-12 border-b border-zinc-800 flex items-center justify-between px-6 shrink-0">
          <span className="text-sm text-zinc-400">
            {page === 'log' ? 'Call Log' : 'System Status'}
          </span>
          <button
            onClick={() => fetchAll()}
            className="flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-300 transition-colors"
          >
            <RefreshCw size={13} className={loading ? 'animate-spin' : ''} />
            Refresh
          </button>
        </header>

        <div className="flex-1 p-6 overflow-auto">
          <AnimatePresence mode="wait">
            {page === 'log' ? (
              <motion.div key="log" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
                <CallLogPage />
              </motion.div>
            ) : (
              <motion.div key="status" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
                <StatusPage />
              </motion.div>
            )}
          </AnimatePresence>
        </div>
      </main>
    </div>
  )
}
